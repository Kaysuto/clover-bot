# ═══════════════════════════════════════════════════════════════
#  Clover Games — Bot Discord — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════════════

# ── Discord ───────────────────────────────────────────────────────
# Portail dev (https://discord.com/developers/applications) → onglet Bot → Token
DISCORD_TOKEN=your_bot_token
# Même application OAuth que le site
DISCORD_CLIENT_ID=your_discord_client_id
# Guilde principale (déploiement des commandes slash)
DISCORD_GUILD_ID=your_guild_id

# ── Base de données principale — Supabase auto-hébergé (partagée avec le site)
# Mode session : le bot est un processus long et drizzle-kit réutilise cette
# même URL pour le DDL, ce que le mode transaction supporte mal.
DATABASE_URL=postgresql://postgres:password@pg.clovergames.fr:6544/postgres_session?sslmode=verify-full

# ── Serveur Minecraft ─────────────────────────────────────────────
MC_HOST=play.clovergames.fr
MC_PORT=25565

# ── Statut affiché sous le nom du bot ─────────────────────────────
# Rendu : « Joue à play.clovergames.fr »
BOT_ACTIVITY_NAME=play.clovergames.fr
# Playing | Listening | Watching | Competing
BOT_ACTIVITY_TYPE=Playing

# ── RCON (optionnel — statut détaillé + messages in-game) ────────
RCON_HOST=play.clovergames.fr
RCON_PORT=25575
RCON_PASSWORD=

# ── Monitoring ────────────────────────────────────────────────────
WEBSITE_URL=https://clovergames.fr
# Optionnel : alertes de panne (transition UP→DOWN uniquement)
DISCORD_MONITORING_WEBHOOK_URL=

# ── MySQL Minecraft (codes de liaison in-game, module link du plugin) ─────────
# Renseigner host + user + name active /lier et /delier. Le préfixe doit être
# identique à storage.table-prefix du plugin (table clover_link_codes).
MINECRAFT_DB_HOST=
MINECRAFT_DB_PORT=3306
MINECRAFT_DB_USER=
MINECRAFT_DB_PASSWORD=
MINECRAFT_DB_NAME=
MINECRAFT_DB_TABLE_PREFIX=clover_

LOG_LEVEL=info
NODE_ENV=development
