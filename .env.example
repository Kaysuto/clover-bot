# ═══════════════════════════════════════════════════════════════
#  Clover Games — Bot Discord — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════════════

# ── Discord ───────────────────────────────────────────────────────
# Portail dev (https://discord.com/developers/applications) → onglet Bot → Token
DISCORD_TOKEN=your_bot_token
# Même application OAuth que le site
DISCORD_CLIENT_ID=your_discord_client_id
# Guilde principale (déploiement des commandes slash)
DISCORD_GUILD_ID=your_guild_id

# ── Base de données principale — Supabase auto-hébergé (partagée avec le site)
# Mode session : le bot est un processus long et drizzle-kit réutilise cette
# même URL pour le DDL, ce que le mode transaction supporte mal.
DATABASE_URL=postgresql://postgres:password@pg.clovergames.fr:6544/postgres_session?sslmode=verify-full

# ── Serveur Minecraft ─────────────────────────────────────────────
MC_HOST=play.clovergames.fr
MC_PORT=25565

# ── Statut affiché sous le nom du bot ─────────────────────────────
# Rendu : « Joue à play.clovergames.fr »
BOT_ACTIVITY_NAME=play.clovergames.fr
# Playing | Listening | Watching | Competing
BOT_ACTIVITY_TYPE=Playing

# ── RCON (optionnel — statut détaillé + messages in-game) ────────
# Historique : sert de repli pour le serveur marqué « défaut » du registre.
RCON_HOST=play.clovergames.fr
RCON_PORT=25575
RCON_PASSWORD=

# Un mot de passe par serveur du réseau, nommé d'après sa clé dans /reseau liste.
# L'hôte et le port, eux, vivent en base (table bot_servers) et se règlent avec
# /reseau modifier. Sans mot de passe, le serveur est pingé mais son RCON reste
# inactif : ni statut RCON, ni propagation de sanction, ni récompense in-game.
RCON_PASSWORD_LOBBY=
RCON_PASSWORD_PVPSOUP=
RCON_PASSWORD_SKYPVP=
RCON_PASSWORD_PRACTICE=
RCON_PASSWORD_CREATIF=
RCON_PASSWORD_BEDWARS=

# ── Monitoring ────────────────────────────────────────────────────
WEBSITE_URL=https://clovergames.fr
# Optionnel : alertes de panne (transition UP→DOWN uniquement)
DISCORD_MONITORING_WEBHOOK_URL=

# ── MySQL Minecraft (codes de liaison in-game, module link du plugin) ─────────
# Renseigner host + user + name active /lier et /delier. Le préfixe doit être
# identique à storage.table-prefix du plugin (table clover_link_codes).
MINECRAFT_DB_HOST=
MINECRAFT_DB_PORT=3306
MINECRAFT_DB_USER=
MINECRAFT_DB_PASSWORD=
MINECRAFT_DB_NAME=
MINECRAFT_DB_TABLE_PREFIX=clover_

# ── MySQL LuckPerms (grades en jeu → rôles Discord, LECTURE SEULE) ────────────
# Base distincte de celle du plugin : ne pas réutiliser MINECRAFT_DB_* par
# commodité. Renseigner host + user + name active /config grades.
LUCKPERMS_DB_HOST=
LUCKPERMS_DB_PORT=3306
LUCKPERMS_DB_USER=
LUCKPERMS_DB_PASSWORD=
LUCKPERMS_DB_NAME=
LUCKPERMS_TABLE_PREFIX=luckperms_

# ── Réception des votes (listes de serveurs Minecraft) ────────────────────────
# Les deux variables sont requises pour ouvrir l'endpoint POST/GET /vote.
# Le jeton est la SEULE protection de ce port public : le générer long et
# aléatoire (openssl rand -hex 32) et le donner à chaque liste de serveurs.
VOTE_HTTP_PORT=
VOTE_TOKEN=

# ── Crédits et boutique (endpoints internes du site) ──────────────────────────
# Le bot ne touche jamais à l'économie in-game : il demande au site de lire un
# solde, de débiter un achat ou de verser une récompense de parrainage. Le
# jeton doit être identique à BOT_API_TOKEN côté site (openssl rand -hex 32).
# Absentes, les crédits et la boutique sont simplement inactifs.
SITE_API_URL=https://clovergames.fr
SITE_API_TOKEN=

LOG_LEVEL=info
NODE_ENV=development
