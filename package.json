{
  "name": "clover-bot",
  "version": "1.0.0",
  "description": "Bot Discord officiel du réseau Clover Games",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "deploy": "tsx src/deploy-commands.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "discord-html-transcripts": "^3.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "minecraft-server-util": "^5.4.4",
    "mysql2": "^3.23.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "rcon-client": "^4.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
